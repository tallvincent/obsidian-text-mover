		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"prettier": "^3.9.10",
		"vitest": "^3.2.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
