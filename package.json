{
	"name": "text-mover",
	"version": "1.0.0",
	"description": "Move text from one file to another.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
